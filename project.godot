config_version=5
[application]
config/name="PixelFX 0.1.0"
run/main_scene="res://demos/pixelfx/fireball_demo.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
[display]
window/size/viewport_width=1120
window/size/viewport_height=740
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
[editor_plugins]
enabled=PackedStringArray("res://addons/pixelfx/plugin.cfg")
[audio]
driver/enable_input=false
